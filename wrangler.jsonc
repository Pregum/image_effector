{
  "name": "image-effector",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // OGPの絶対URLを配信時に埋めるため、HTMLのページだけWorkerを先に通す
    "run_worker_first": ["/", "/about", "/about-en"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noiz-lab",
      "database_id": "082e6067-8427-44ff-be09-22aa37daa650"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "noiz-lab-works"
    }
  ],
  // 需要の把握用。未設定でも動く（バインディングが無ければ計測は自動的に無効）
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "noiz_lab_events"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
  ],
  "observability": {
    "enabled": true
  }
}
