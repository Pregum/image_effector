# ローカル開発用の環境変数（wrangler dev が読み込む）
# 本番は `npx wrangler secret put <名前>` で設定する

# ギャラリー機能のアクセスキー（任意の長い文字列）。
# 未設定ならギャラリー機能は自動的に無効になる。
GALLERY_KEY=change-me-to-a-long-random-string

# --- AIプロバイダ ---
# workers-ai (既定) | openai | none
# AI_PROVIDER=openai

# OpenAI互換エンドポイント（Ollama / LM Studio / vLLM / LiteLLM / OpenAI本家）
# 例: Ollama をローカルで動かす場合（wrangler dev なら localhost に届く）
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama

# モデル名（省略時はプロバイダごとの既定値）
# AI_MODEL_CHAT=llama3.3
# AI_MODEL_CHAT_SMALL=llama3.2
# AI_MODEL_IMAGE=dall-e-3
# AI_MODEL_VISION=llava
# AI_MODEL_EMBED=bge-m3

# 1日あたりのAI予算（Workers AIの無料枠10,000ニューロンの手前で止める）
# AI_DAILY_CAP=8000

# --- 計測（すべて任意。未設定なら計測は行われない） ---
# Cloudflare Web Analytics のトークン（ダッシュボードで発行される32桁の16進文字列）。
# 設定するとページビュー・リファラ・国・Core Web VitalsがCloudflare側で見られる。
# WEB_ANALYTICS_TOKEN=0123456789abcdef0123456789abcdef

# Google Analytics 4 の測定ID。設定したときだけgtagが読み込まれる。
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Plausible（またはUmami等の互換スクリプト）に登録したドメイン。
# PLAUSIBLE_DOMAIN=example.com
# セルフホスト版を使う場合のスクリプトURL（https:// で終端が .js のみ許可）
# PLAUSIBLE_SRC=https://analytics.example.com/js/script.js

# 機能ごとの利用回数は wrangler.jsonc の analytics_engine_datasets に書き出される。
# バインディングを外せば、その計測も丸ごと無効になる。
